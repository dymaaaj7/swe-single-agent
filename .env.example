# SWE-agent Environment Configuration
# Copy this file to .env and fill in your values

# Required: The model name to use (e.g., gpt-4o, claude-3-opus-20240229, etc.)
OPENAI_MODEL_NAME=openai/glm-4.7

# Required: Your API key for the model provider
OPENAI_API_KEY=your_key

# Optional: Custom API base URL (defaults to provider's standard URL)
# Uncomment and modify if using a custom endpoint or proxy
OPENAI_BASE_URL=https://api.z.ai/api/coding/paas/v4

# Optional: Other common API keys (if not using SWE_AGENT_API_KEY)
# OPENAI_API_KEY=your-openai-key
# ANTHROPIC_API_KEY=your-anthropic-key
# GITHUB_TOKEN=your-github-token
